#!/usr/bin/env bash
# Code Review Cadre: benchmark AI code reviewers on YOUR repo, staff a panel,
# then run that panel on the code you are about to ship.
#
#   cadre setup <repo-dir> [limit]        mine (target, fix) commit pairs
#   cadre make-pass <label> <repo-dir> <target-sha> <fix-sha>
#                                         build the leak-controlled checkout and
#                                         DRAFT an answer key for you to correct
#   cadre add-pass <label>                register a corrected draft as a pass
#   cadre run <agent-spec> [runs] [label] run a candidate, grade it, recommend a slot
#   cadre grade <agent-spec> [runs]       re-grade existing outputs, no agent runs
#   cadre adjudicate <agent-spec> [runs]  OPEN track: are its findings real?
#   cadre panel [--save]                  compare graded candidates, propose a panel
#   cadre review [opts] [target]          run the staffed roster on a REAL change
#                                         (--full reviews the target as it stands)
#   cadre passes                          list registered passes
#   cadre agents                          list adapters
#   cadre doctor [--probe]                check the install and the passes
#   cadre onboard [--brief]               add a second reviewer for free
#   cadre ledger [show|path]              findings you have already ruled on
#   cadre settle <review> [--judge spec]  split a review into NEW vs settled
#
# <agent-spec> is anything agentcall takes: "codex", or "opencode:vendor/model".
# Recommends. Never changes your review lineup. See README.md.
set -uo pipefail

SELF_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
export CADRE_ROOT="${CADRE_ROOT:-$(dirname "$SELF_DIR")}"
# shellcheck source=lib/common.sh
. "$CADRE_ROOT/lib/common.sh"
# shellcheck source=lib/grade.sh
. "$CADRE_ROOT/lib/grade.sh"
# shellcheck source=lib/adjudicate.sh
. "$CADRE_ROOT/lib/adjudicate.sh"

PASSES="$CADRE_HOME/passes.conf"

usage() {
  cat <<'EOF'
Code Review Cadre: benchmark AI code reviewers on YOUR repo, staff a panel,
then run that panel on the code you are about to ship.

  cadre setup <repo-dir> [limit]        mine (target, fix) commit pairs
  cadre make-pass <label> <repo-dir> <target-sha> <fix-sha>
                                        build the leak-controlled checkout and
                                        DRAFT an answer key for you to correct
  cadre add-pass <label>                register a corrected draft as a pass
  cadre run <agent-spec> [runs] [label] run a candidate, grade it, recommend a slot
  cadre grade <agent-spec> [runs]       re-grade existing outputs, no agent runs
  cadre adjudicate <agent-spec> [runs] [label]
                                        OPEN track. Check EVERY finding the
                                        candidate stated against the checkout it
                                        reviewed; report real / false /
                                        unfalsifiable counts. The keyed score is a
                                        floor, this measures the rest of the review
                                        and never feeds the slot recommendation.
  cadre panel [--save [--force]]        compare all graded candidates, propose a
                                        panel; --save writes a commented roster
  cadre review [opts] [target]          run the staffed roster against a REAL
                                        change and collect the reviews
      --base <rev>       diff against this (default: merge-base with the
                         default branch)
      --full             review <target> as it STANDS, with no diff. The target
                         can be a repo, a subdirectory, a directory that is not
                         a repo at all, or a single file. Opposite of --base.
                         .gitignore is honoured; refuses a target over
                         CADRE_TARGET_MAX_FILES (2000) or _MAX_KB (20480).
      --roster a,b,c     override $CADRE_HOME/roster
      --jobs N           reviewers in parallel (default 1; they share rate limits)
      --synth <spec>     merge the reviews with this agent (default $CADRE_SYNTH)
      --label <name>     output dir name; labels are single-use
      --prerun <cmd>     run <cmd> once on a throwaway copy of the checkout and
                         give every reviewer the transcript. Off unless you ask.
  cadre passes                          list registered passes
  cadre agents                          list adapters
  cadre doctor [--probe]                check the install and the passes
  cadre onboard [--brief]               walk through adding a second reviewer
                                        for free. --brief prints a prompt to
                                        hand your own coding agent instead.
  cadre ledger [show|path]              findings you have already ruled on
  cadre settle <review> [--judge spec]  split a review into NEW vs already
                                        settled. Exits 0 when nothing is new.

<agent-spec> is anything agentcall takes: "codex", or "opencode:vendor/model".

Environment:
  CADRE_HOME    state dir (default ${XDG_STATE_HOME:-~/.local/state}/cadre)
  CADRE_WORK    where checkouts live. MUST be outside CADRE_HOME, or an agent
                reaches the answer keys by relative path from its own cwd.
  CADRE_JUDGE   agent that grades reviews against the key. Takes the same
                agent:provider/model spec a candidate does. Give it TWO, comma
                separated, and both grade every run: an item they agree on is
                the grade, an item they split on is UNRESOLVED and scores
                nothing. Two graders here split on about one item in three, so
                one judge's reading is a hypothesis, not a measurement. Max 2 --
                beyond that "they agree" becomes a vote.
  CADRE_ADJUDICATOR  agent for `cadre adjudicate`. Required, and deliberately
                NOT defaulted from CADRE_JUDGE: it reads the CHECKOUT to rule on
                whether a finding is real, which the judge never does. Do not
                point it at the candidate being adjudicated.
  CADRE_STACK   one line of context added to the review brief
  CADRE_TEST_CMD  override the detected test command
  CADRE_RETRIES     attempts when a call comes back rate limited (default 3)
  CADRE_RETRY_WAIT  first backoff in seconds, doubling, capped at 600 (default 60)
EOF
}

# True when $1 is inside directory $2. readlink -m so a path that does not
# exist yet still resolves.
is_inside() {
  local a b; a=$(readlink -m "$1"); b=$(readlink -m "$2")
  [ -n "$a" ] && [ -n "$b" ] || return 1
  [ "$a" = "$b" ] && return 1
  case "$a/" in "$b"/*) return 0 ;; esac
  return 1
}

init_home() {
  mkdir -p "$CADRE_HOME/keys" "$CADRE_HOME/passes.d" "$CADRE_WORK"
  [ -f "$PASSES" ] || cp "$CADRE_ROOT/templates/passes.conf" "$PASSES"
}

# The judge is a model too. Default to the first installed candidate and SAY
# which one, because a silently-chosen judge is a silently-chosen bias.
pick_judge() {
  [ -n "$CADRE_JUDGE" ] && return 0
  local a
  for a in claude codex grok opencode; do
    agent_installed "$a" && { CADRE_JUDGE="$a"; return 0; }
  done
  return 1
}
need_judge() {
  pick_judge || die "no judge available, set CADRE_JUDGE to an agent agentcall can run"
  # Catch a typo or a missing CLI here. Otherwise every call fails and the whole
  # pass reports UNUSABLE, which reads like a bad candidate rather than a bad
  # judge. CADRE_JUDGE may carry a model: check the agent half.
  # ★ agent_installed, not command -v on the name: CADRE_JUDGE=cursor died as
  # "not installed" with `agent` sitting on the user's PATH. See common.sh.
  local js=(); mapfile -t js < <(judge_specs)
  local j ja
  for j in "${js[@]}"; do
    ja=$(spec_agent "$j")
    agent_installed "$ja" || die "CADRE_JUDGE names '$j' but '$ja' is not installed"
  done
  [ "${#js[@]}" -le 2 ] || die "CADRE_JUDGE names ${#js[@]} judges. Two is the most this scores.
     Beyond two, 'they agree' stops being a rule and becomes a vote, and a
     majority over three noisy graders reads as consensus while hiding that one
     of them dissented. Pick the two whose failures you expect to differ."
  # ★ Same rule as the review roster, for the same reason. Two graders of one
  # lineage are one grader in two seats: they agree where a single grader was
  # already confident and split where it was already unsure, so their agreement
  # is not independent evidence and the gate it feeds is decorative. A warning,
  # never a refusal -- comparing two efforts of one model is a real experiment.
  if [ "${#js[@]}" -gt 1 ]; then
    local fams=() dup
    for j in "${js[@]}"; do fams+=("$(spec_family "$j")"); done
    dup=$(printf '%s\n' "${fams[@]}" | sort | uniq -d)
    [ -n "$dup" ] && echo "⚠ ${js[*]} are both $dup models. Two graders of one lineage agree
  where one grader was already confident and split where it was not, so their
  agreement is not independent evidence about the candidate."
  fi
  return 0
}

cmd_passes() {
  [ -f "$PASSES" ] || { echo "no passes yet. Start with: cadre setup <repo-dir>"; return 0; }
  printf '%-18s %-10s %-24s %-10s %s\n' LABEL SHA CHECKOUT BASE KEY
  local label sha dir base key
  while IFS='|' read -r label sha dir base key; do
    case "$label" in ''|\#*) continue ;; esac
    printf '%-18s %-10s %-24s %-10s %s\n' "$label" "$sha" "$dir" "$base" "$key"
  done < "$PASSES"
}

cmd_setup() {
  local repo="${1:?usage: cadre setup <repo-dir> [limit]}" limit="${2:-200}"
  [ -d "$repo/.git" ] || die "not a git repo: $repo"
  init_home
  local out="$CADRE_HOME/shortlist-$(basename "$(readlink -f "$repo")").tsv"
  echo "mining fix-commit pairs in $repo (last $limit fix-shaped commits)…"
  "$CADRE_ROOT/lib/mine-fixes.sh" "$repo" "$limit" | tee "$out"
  echo
  # ★ Do not tell someone to "pick a row" from an empty table. The miner has
  # already explained on stderr WHICH filter emptied it; this only has to stop
  # promising a next step that does not exist.
  local rows; rows=$(($(wc -l < "$out") - 1))
  [ "$rows" -lt 0 ] && rows=0
  if [ "$rows" -eq 0 ]; then
    cat <<EOF
no pass candidates. See the tally above for which filter emptied the table.
The header-only file is still at: $out
EOF
    return 0
  fi
  echo "saved: $out"
  cat <<EOF

Each of the $rows row(s) is a candidate pass: the author broke something in
target_sha and repaired it in fix_sha, WITH a test change proving the defect
was real.

Pick a row where the fix is a behavioural repair you would have wanted a
reviewer to catch, then:

  cadre make-pass <label> $repo <target_sha> <fix_sha>
EOF
}

cmd_make_pass() {
  local label="${1:?usage: cadre make-pass <label> <repo-dir> <target-sha> <fix-sha>}"
  local repo="${2:?need repo dir}" target="${3:?need target sha}" fix="${4:?need fix sha}"
  case "$label" in *[!a-zA-Z0-9_-]*) die "label must be [a-zA-Z0-9_-]" ;; esac
  init_home; need_judge
  need git; need jq

  mkdir -p "$CADRE_WORK"
  local dest; dest=$(mktemp -d "$CADRE_WORK/$label-XXXXXXXX") || die "could not create a checkout dir"
  rmdir "$dest"   # git clone wants to create it
  git -C "$repo" cat-file -e "$target^{commit}" 2>/dev/null || die "no such commit: $target"
  git -C "$repo" cat-file -e "$fix^{commit}" 2>/dev/null    || die "no such commit: $fix"

  # ★ Leak control. The fix commit's SUBJECT LINE usually states the answer and
  # every reviewer has git. A shallow single-branch clone pinned at the target
  # has no future history to read. docs/METHOD.md §5.
  local tmpbranch="cadre/$label"
  git -C "$repo" rev-parse --verify -q "$tmpbranch" >/dev/null 2>&1 && \
    die "branch $tmpbranch already exists in $repo, pick another label"
  git -C "$repo" branch "$tmpbranch" "$target" >/dev/null 2>&1 || die "could not create $tmpbranch"
  git clone --quiet --depth 2 --single-branch --branch "$tmpbranch" \
      "file://$(readlink -f "$repo")" "$dest" || { git -C "$repo" branch -D "$tmpbranch" >/dev/null 2>&1; die "clone failed"; }
  git -C "$repo" branch -D "$tmpbranch" >/dev/null 2>&1
  # No origin at all, so nothing can fetch the future history back in.
  git -C "$dest" remote remove origin >/dev/null 2>&1 || true

  echo "checkout: $dest"
  echo "history visible to a reviewer:"
  git -C "$dest" log --oneline | sed 's/^/  /'
  local n; n=$(git -C "$dest" rev-list --count HEAD)
  [ "$n" -le 2 ] || echo "  ⚠ $n commits visible, deeper than expected, check for leaks"

  secrets_preflight "$dest"

  echo
  echo "drafting an answer key with $CADRE_JUDGE …"
  local keyfile="$CADRE_HOME/keys/$label.md" tmp
  tmp=$(mktemp)
  {
    cat "$CADRE_ROOT/lib/prompts/keygen.md"
    echo
    echo "=============== TARGET COMMIT ($target) ==============="
    git -C "$repo" show --stat --patch "$target" | head -c 200000
    echo
    echo "=============== FIX COMMIT ($fix) ==============="
    git -C "$repo" show --stat --patch "$fix" | head -c 200000
  } > "$tmp"
  {
    echo "<!-- CADRE-DRAFT: machine-written, not yet reviewed by a human."
    echo "     Correct it, then delete this comment and run: cadre add-pass $label -->"
    echo
    judge_call < "$tmp"
  } > "$keyfile"
  rm -f "$tmp"

  local base="HEAD~1"
  [ "$n" -lt 2 ] && echo "  ⚠ only one commit visible (target is a root commit), edit the base field in passes.conf by hand"
  printf '%s|%s|%s|%s|%s\n' "$label" "${target:0:9}" "$dest" "$base" "keys/$label.md" \
    > "$CADRE_HOME/passes.d/$label.meta"

  cat <<EOF

draft key: $keyfile

★ READ IT AND FIX IT. A key the judge wrote and the judge grades against
measures agreement-with-the-generator, not review quality. The fix commit is
your external evidence; the draft is just a transcription of it, and it will
get severities wrong, invent items, or miss the point of the repair.

Then register it:

  cadre add-pass $label
EOF
}

cmd_add_pass() {
  local label="${1:?usage: cadre add-pass <label>}"
  init_home
  local meta="$CADRE_HOME/passes.d/$label.meta"
  [ -f "$meta" ] || die "no draft for '$label', run cadre make-pass first"
  local keyfile="$CADRE_HOME/keys/$label.md"
  [ -f "$keyfile" ] || die "no key at $keyfile"
  grep -q 'CADRE-DRAFT' "$keyfile" && \
    die "$keyfile still carries the DRAFT marker, read it, correct it, delete the marker"
  local probs; probs=$(key_problems "$keyfile")
  [ -z "$probs" ] || {
    echo "cadre: refusing to register '$label'. The key is not gradeable:" >&2
    printf '%s\n' "$probs" | sed 's/^/  /' >&2
    die "severity is read out of each item's heading, so an item without one scores as if it does not matter"
  }
  grep -q "^$label|" "$PASSES" 2>/dev/null && die "pass '$label' is already registered"
  cat "$meta" >> "$PASSES"
  echo "registered: $(cat "$meta")"
  echo "next: cadre run codex 2"
}

cmd_run() {
  local spec="${1:?usage: cadre run <agent-spec> [runs] [pass-label]}"
  local runs="${2:-2}" only="${3:-}"
  init_home; need_judge; need jq
  need_runs "$runs"

  # A freshly initialised passes.conf is the comment-only template, so -s is
  # true and nothing is registered. Fail at the gate, not four steps later.
  local npasses; npasses=$(grep -cvE '^[[:space:]]*(#|$)' "$PASSES" || true)
  [ "${npasses:-0}" -gt 0 ] || die "no passes registered, start with: cadre setup <repo-dir>"
  if [ -n "$only" ]; then
    grep -q "^[[:space:]]*$only|" "$PASSES" || die "no pass named '$only' (see: cadre passes)"
    npasses=1
  fi
  local jspecs=(); mapfile -t jspecs < <(judge_specs)
  echo "judge(s): ${jspecs[*]}   candidate: $spec"
  # ★ Per judge, not against $CADRE_JUDGE as a whole. With two judges the whole
  # string is "a,b", spec_agent returns "a,b", and the comparison silently
  # stopped firing -- so the one case this warns about, a candidate grading
  # itself, went unmentioned exactly when a second judge made it easy to hit.
  local j
  for j in "${jspecs[@]}"; do
    [ "$(spec_agent "$spec")" = "$(spec_agent "$j")" ] &&
      echo "⚠ the candidate and judge '$j' are the same CLI, it will be grading itself."
  done
  echo "up to $((npasses * runs)) review calls + $((npasses * ${#jspecs[@]} * runs)) judge calls."
  echo "(a ceiling, not a plan: outputs and grades that already exist are reused)"
  echo
  run_gauntlet "$spec" "$runs" 0 "$only"
}

cmd_grade() {
  local spec="${1:?usage: cadre grade <agent-spec> [runs]}" runs="${2:-2}"
  init_home; need_judge; need jq
  need_runs "$runs"
  run_gauntlet "$spec" "$runs" 1 "${3:-}"
}

# The OPEN track. Deliberately its own command and not part of `run`: it is a
# second model call per run, and the keyed score has to stand on its own without
# it. See lib/adjudicate.sh for why one ratio is not reported.
cmd_adjudicate() {
  local cand="${1:?usage: cadre adjudicate <candidate-spec> [runs] [pass-label]}"
  local runs="${2:-2}"
  init_home; need jq
  # ★ Never defaults to CADRE_JUDGE. The judge grades review TEXT against a key and
  # has earned no standing to rule on whether code contains a defect -- measured, it
  # silently returned zero findings against a review stating seven, and graded the
  # same text two different ways on a re-grade. This call reads the actual checkout,
  # so it is a different job and it is named separately.
  [ -n "${CADRE_ADJUDICATOR:-}" ] || die "set CADRE_ADJUDICATOR to the agent that should
     check these findings against the code. It is deliberately NOT \$CADRE_JUDGE:
     the judge only ever sees review text and a key, never the repository.
     Pick something that is not the candidate being adjudicated."
  run_adjudication "$CADRE_ADJUDICATOR" "$cand" "$runs" "${3:-}"
}

# Compare every graded candidate and propose a panel. The step that makes the
# output a roster instead of a rank: it reads the per-item rows out of the
# reports and asks which items NOTHING in the lineup covers.
cmd_panel() {
  init_home
  local save=0 force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --save)  save=1 ;;
      --force) force=1 ;;
      *) die "panel: unknown option '$1'" ;;
    esac
    shift
  done
  local reports=("$CADRE_HOME"/report-*.md)
  [ -e "${reports[0]}" ] || die "no graded candidates yet. Run: cadre run <agent>"

  local rows=() passes=() invalid=() r line pass base judge spec rowid
  declare -A grade seen rowspec passitems firstv flip
  for r in "${reports[@]}"; do
    spec=$(sed -n '1s/^# Gauntlet: `\(.*\)`$/\1/p' "$r"); [ -n "$spec" ] || continue
    # ★ An INVALID report measured nothing about the candidate. Its surviving
    # HIT rows cannot close a coverage gap: the leaked run proves the setup was
    # compromised, not that this candidate is stronger or weaker than the rest.
    # README says the whole pass is excluded from scoring. This is the place
    # that was still spending it.
    if grep -q '^## Verdict: INVALID' "$r"; then invalid+=("$spec"); continue; fi
    # ★ Two judges grading one candidate are two OBSERVATIONS, not one. The
    # report filename carries the judge for exactly this reason; keying the
    # matrix by candidate alone folded both judges into a single cell and
    # erased the disagreement those filenames were added to preserve.
    base=$(basename "$r" .md)
    case "$base" in *-by-*) judge=${base##*-by-} ;; *) judge="" ;; esac
    rowid="$spec${judge:+  (judge: $judge)}"
    [ -n "${seen[row:$rowid]:-}" ] || { rows+=("$rowid"); seen[row:$rowid]=1; rowspec[$rowid]=$spec; }
    # ★ K numbers are LOCAL to one answer key: every pass starts at K1. Keying
    # items by number alone folded pass alpha's K1 (auth bypass) together with
    # pass beta's K1 (dropped write), so a hit on one could report the other as
    # covered. Columns are per pass from here down.
    pass="(unlabelled)"
    while IFS= read -r line; do
      if [ "${line#\#\# }" != "$line" ]; then
        pass=${line#\#\# }
        case "$pass" in Verdict:*) pass="" ;; esac
        continue
      fi
      [ -n "$pass" ] || continue
      local kv k v
      for kv in $(grep -oE '\bK[0-9]+=(HIT|DEFER|MISS)' <<<"$line"); do
        k=${kv%%=*}; v=${kv#*=}
        [ -n "${seen[pass:$pass]:-}" ] || { passes+=("$pass"); seen[pass:$pass]=1; }
        case " ${passitems[$pass]:-} " in
          *" $k "*) ;; *) passitems[$pass]="${passitems[$pass]:-} $k" ;;
        esac
        # ★ Did this candidate's OWN runs agree with each other? The cell below
        # is the best grade it ever reached, which is the right thing to staff
        # from -- a reviewer that finds the bug half the time still finds it --
        # but collapsing to best-ever hides the difference between "caught it
        # twice" and "caught it once and missed it once". That difference is
        # the whole question this tool is weakest on: at two runs a cell that
        # flips is indistinguishable from a lineage that genuinely covers what
        # the others miss, and a panel staffed on a coin flip is the failure
        # mode the matrix is supposed to prevent. Recorded, marked, never
        # silently averaged away.
        if [ -z "${firstv[$rowid,$pass,$k]:-}" ]; then
          firstv[$rowid,$pass,$k]=$v
        elif [ "${firstv[$rowid,$pass,$k]}" != "$v" ]; then
          flip[$rowid,$pass,$k]=1
        fi
        # Best grade this candidate ever achieved on the item. A DEFER is
        # recorded even when another run hit, because a DEFER is the finding.
        case "${grade[$rowid,$pass,$k]:-}" in
          DEFER) ;;
          HIT) [ "$v" = DEFER ] && grade[$rowid,$pass,$k]=DEFER ;;
          *)   grade[$rowid,$pass,$k]=$v ;;
        esac
      done
    done < "$r"
  done
  if [ ${#invalid[@]} -gt 0 ]; then
    echo "EXCLUDED as suspected key leaks, so they score nothing here: ${invalid[*]}"
    echo "  Those reports are INVALID. Fix the leak and re-run before comparing them."
    echo
  fi
  [ ${#rows[@]} -gt 0 ] || die "no scorable reports in $CADRE_HOME.
     Reports exist, but every one of them is INVALID or unreadable."

  # Items of one pass, in numeric order. Unquoted on purpose: word splitting is
  # how the accumulated list becomes arguments.
  panel_items() { printf '%s\n' ${passitems[$1]:-} | sed 's/^K//' | sort -n | sed 's/^/K/'; }
  # $1 is a line prefix so `--save` can write the same matrix commented out.
  panel_matrix() {
    local pfx="$1" p ki s
    for p in "${passes[@]}"; do
      echo "${pfx}pass $p"
      printf '%s%-44s' "$pfx" 'CANDIDATE'
      for ki in $(panel_items "$p"); do printf '%-8s' "$ki"; done
      echo
      for s in "${rows[@]}"; do
        printf '%s%-44s' "$pfx" "$s"
        for ki in $(panel_items "$p"); do
          printf '%-8s' "${grade[$s,$p,$ki]:-.}${flip[$s,$p,$ki]:+*}"
        done
        echo
      done
      echo "$pfx"
    done
  }
  panel_matrix ''

  local gaps=() deferrers=() p ki s
  for p in "${passes[@]}"; do
    for ki in $(panel_items "$p"); do
      local covered=0
      for s in "${rows[@]}"; do [ "${grade[$s,$p,$ki]:-}" = HIT ] && covered=1; done
      [ "$covered" -eq 0 ] && gaps+=("$p/$ki")
    done
  done
  for s in "${rows[@]}"; do
    for p in "${passes[@]}"; do
      for ki in $(panel_items "$p"); do
        [ "${grade[$s,$p,$ki]:-}" = DEFER ] && { deferrers+=("$s"); break 2; }
      done
    done
  done

  if [ ${#deferrers[@]} -gt 0 ]; then
    echo "DO NOT SLOT: ${deferrers[*]}"
    echo "  Deferred on an item, found the defect and argued it was fine. That is"
    echo "  worse than missing it. See docs/METHOD.md section 3."
    echo
  fi
  # ★ An item covered ONLY by a cell that flipped is not covered, it is covered
  # on a coin flip. This is the line that separates "we staffed a decorrelated
  # panel" from "one run got lucky", and without it the matrix reads the same
  # either way.
  local shaky=()
  for p in "${passes[@]}"; do
    for ki in $(panel_items "$p"); do
      local firm=0 any=0
      for s in "${rows[@]}"; do
        [ "${grade[$s,$p,$ki]:-}" = HIT ] || continue
        any=1; [ -n "${flip[$s,$p,$ki]:-}" ] || firm=1
      done
      [ "$any" -eq 1 ] && [ "$firm" -eq 0 ] && shaky+=("$p/$ki")
    done
  done
  if [ ${#shaky[@]} -gt 0 ]; then
    echo "★ Caught only by a reviewer whose OWN runs disagreed: ${shaky[*]}"
    echo "  Those cells are marked *. The candidate found it in one run and missed"
    echo "  it in another, on the same checkout and the same prompt, so this is"
    echo "  coverage on a coin flip. Run more runs before you staff around it:"
    echo "  a cell that flips is what variance looks like, and at two runs it is"
    echo "  indistinguishable from a lineage that genuinely covers what the rest"
    echo "  of the panel misses."
    echo
  fi
  if [ ${#gaps[@]} -gt 0 ]; then
    echo "★ NOTHING in this lineup catches: ${gaps[*]}"
    echo "  This is the most useful line here. Adding a higher-scoring candidate"
    echo "  that agrees with the others changes nothing. Add a model family you"
    echo "  do not already have and see whether it covers these."
  else
    echo "Every key item is caught by at least one candidate."
  fi
  echo
  echo "Pick the smallest set of rows that covers every column. Prefer a"
  echo "candidate that covers a column no one else does, even at a lower total."
  echo "cadre does not choose for you."

  [ "$save" = 1 ] || return 0

  # ★ Every candidate is written COMMENTED OUT. Writing an uncommented roster
  # would be cadre choosing the panel, which is the one thing the whole tool
  # declines to do. The user uncomments; `cadre review` refuses an all-commented
  # roster and says so.
  local roster="$CADRE_HOME/roster"
  if [ -s "$roster" ] && [ "$force" != 1 ]; then
    die "a roster already exists at $roster.
     Re-running panel would overwrite the lineup you staffed.
     Use 'cadre panel --save --force' if that is what you want."
  fi
  {
    echo "# Staffed panel for 'cadre review'. Uncomment the reviewers you want."
    echo "# cadre does not choose for you: every line below starts commented out."
    echo "#"
    echo "# Coverage at the time this was written:"
    echo "#"
    panel_matrix '#   '
    [ ${#gaps[@]} -gt 0 ] && { echo "# ★ NOTHING in this lineup catches: ${gaps[*]}"; echo "#"; }
    # One line per candidate, not per grading. A candidate graded by two judges
    # is two rows in the matrix above and still one seat on the panel.
    printf '%s\n' "${rowspec[@]}" | sort -u | sed 's/^/# /'
  } > "$roster" || die "could not write $roster"
  echo
  echo "wrote $roster (all commented). Uncomment your lineup, then: cadre review"
}

# Roster for the live path: --roster, then $CADRE_ROSTER, then the file.
# Accepts commas or newlines, ignores '#' comments and blanks, rejects
# duplicates (two identical specs would double-count in the synthesis tally).
resolve_roster() {
  local raw="" src="" seen=" " s out=()
  if [ -n "${1:-}" ]; then raw="$1"; src="--roster"
  elif [ -n "${CADRE_ROSTER:-}" ]; then raw="$CADRE_ROSTER"; src="\$CADRE_ROSTER"
  elif [ -s "$CADRE_HOME/roster" ]; then raw=$(cat "$CADRE_HOME/roster"); src="$CADRE_HOME/roster"
  else
    # ★ 'cadre panel --save' needs registered passes, and someone hitting this
    # on a fresh install has none. Pointing a first-time user at the one path
    # that is closed to them reads as "this tool is not ready for you", when
    # --roster with what they already have works immediately. Name the CLIs
    # actually on their PATH; fall back to the old text only when there are none.
    local inst; inst=$("$CADRE_ROOT/bin/agentcall" --installed 2>/dev/null | paste -sd, -)
    if [ -n "$inst" ]; then
      die "no roster. You have these installed, so this works right now:

       cadre review --roster $inst

     To make it the default, put them in $CADRE_HOME/roster one per line.
     Once you have graded passes, 'cadre panel --save' writes that file for you."
    fi
    die "no roster, and none of cadre's adapters are on your PATH.
     Install a reviewer CLI first: 'agentcall --list' shows what ships.
     With no subscription, CodeRabbit's free tier is the shortest route in."
  fi
  # ★ printf '%s\n' AND the `|| [ -n "$s" ]` guard. With neither, a value with
  # no trailing newline ("a,b,c" from --roster, or a roster file without one)
  # loses its LAST entry: read returns non-zero on the final partial line, so
  # the loop body never runs for it. Measured: `--roster good,trunc,ghost` ran
  # two reviewers and the report never mentioned the third. A silently dropped
  # reviewer is indistinguishable from one that ran and found nothing, which is
  # the failure this whole tool exists to catch.
  while IFS= read -r s || [ -n "$s" ]; do
    s="${s%%#*}"; s=$(trim "$s")
    [ -n "$s" ] || continue
    case "$seen" in *" $s "*) die "roster: '$s' listed twice ($src)" ;; esac
    seen="$seen$s "
    out+=("$s")
  done < <(printf '%s\n' "$raw" | tr ',' '\n')
  [ ${#out[@]} -gt 0 ] || die "every line in $src is commented out. Uncomment the reviewers you want."
  printf '%s\n' "${out[@]}"
}

# Does this adapter ignore the prompt? coderabbit does: it ships its own review
# contract. Such an adapter cannot synthesize, because synthesis IS a prompt.
is_promptless() {
  local a="$1" d
  ( for d in "$CADRE_ROOT/agents.d" "${CADRE_AGENTS_D:-$CADRE_HOME/agents.d}"; do
      [ -f "$d/$a.sh" ] && . "$d/$a.sh"
    done
    declare -F "noprompt_$a" >/dev/null ) 2>/dev/null
}

cmd_review() {
  init_home; need git; need jq
  local base="" roster_arg="" jobs=1 synth="${CADRE_SYNTH:-}" label="" repo=""
  local prerun="${CADRE_PRERUN:-}" full=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --full)   full=1; shift ;;
      --base)   base="${2:?--base needs a rev}"; shift 2 ;;
      --roster) roster_arg="${2:?--roster needs specs}"; shift 2 ;;
      --jobs)   jobs="${2:?--jobs needs a number}"; shift 2 ;;
      --synth)  synth="${2:?--synth needs an agent spec}"; shift 2 ;;
      --label)  label="${2:?--label needs a name}"; shift 2 ;;
      --prerun) prerun="${2:?--prerun needs a command}"; shift 2 ;;
      -*) die "review: unknown option '$1'" ;;
      *)  repo="$1"; shift ;;
    esac
  done
  case "$jobs" in ''|*[!0-9]*|0) die "--jobs must be a positive integer" ;; esac

  # Keep the argument: the assignment blanks $repo on failure, so reading it in
  # the error names $PWD and reports the wrong directory as "not a git repo".
  local want="${repo:-.}"
  # ★ Two modes, and the mode has to be asked for. There is no safe way to infer
  # it: a repo with no --base already means "diff against the default branch",
  # so treating a bare path as "review everything" would silently turn a diff
  # review into a whole-tree review the first time someone forgot a flag.
  if [ "$full" = 1 ]; then
    [ -z "$base" ] || die "--base and --full are opposites: --base asks for a
     diff against a revision, --full asks for the content as it stands. Pick one."
    [ -e "$want" ] || die "nothing to review at $(readlink -m "$want")"
    repo=$(readlink -m "$want")
  else
    repo=$(git -C "$want" rev-parse --show-toplevel 2>/dev/null) \
      || die "not inside a git repository: $(readlink -m "$want")
     To review this as it stands rather than as a diff, use: cadre review --full $want"
  fi

  # Command substitution, not process substitution: resolve_roster's die runs in
  # a subshell, and with `< <(...)` its exit status is lost, so a duplicate or
  # all-commented roster fell through to run-review.sh's "no reviewers given"
  # and buried the real reason.
  # ★ State inside the repo becomes review input. Untracked files are carried
  # into the checkout, so a CADRE_HOME under $repo hands every auto-approving
  # reviewer the answer keys and every previous reviewer's findings. Same rule
  # the benchmark path enforces on checkouts, applied to the live one.
  # ★ is_inside deliberately returns FALSE for identical paths, so it alone
  # misses CADRE_HOME="$repo" exactly. Measured: that case sailed through and
  # carried state files into the reviewer's checkout. Test equality separately.
  local rp; rp=$(readlink -m "$repo")
  local vn vv
  for vn in CADRE_HOME CADRE_WORK; do
    eval "vv=\$$vn"
    if [ "$(readlink -m "$vv")" = "$rp" ] || is_inside "$vv" "$repo"; then
      # ★ Stricter in --full than in diff mode, not looser. A diff review carries
      # untracked files in; a --full review carries the WHOLE tree in, so state
      # under the target reaches the reviewers even when nothing has changed.
      die "$vn ($vv) is the target being reviewed, or sits inside it.
     Its keys, checkouts and prior reports would be copied into the reviewers'
     checkout. Point $vn somewhere outside $rp."
    fi
  done

  local specs=() rl
  rl=$(resolve_roster "$roster_arg") || exit 2
  mapfile -t specs <<< "$rl"

  # Resolve the base here so the error names something the user typed.
  if [ "$full" = 1 ]; then
    : # no base: an empty base is how run-review.sh is told there is no diff.
  elif [ -z "$base" ]; then
    local db
    db=$(git -C "$repo" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null)
    [ -n "$db" ] || for db in main master; do
      git -C "$repo" rev-parse --verify -q "$db^{commit}" >/dev/null 2>&1 && break || db=""
    done
    [ -n "$db" ] || die "cannot find a default branch to diff against.
     Pass --base explicitly, e.g. --base HEAD~1 or --base origin/main."
    base=$(git -C "$repo" merge-base HEAD "$db" 2>/dev/null) \
      || die "no merge-base between HEAD and $db. Pass --base explicitly."
    echo "base: $db -> $(printf '%.9s' "$base")"
  fi

  if [ -n "$synth" ] && [ "$synth" != none ]; then
    local sa si; sa=$(spec_agent "$synth")
    # Ask agentcall, not the name: an adapter may run a binary it is not named
    # after, and refusing a synthesizer that works is worse than the typo this
    # catches. Captured rather than piped -- see lib/run-review.sh on pipefail.
    si=$("$CADRE_ROOT/bin/agentcall" --installed 2>/dev/null)
    case $'\n'"$si"$'\n' in
      *$'\n'"$sa"$'\n'*) ;;
      *) die "--synth is '$synth' but '$sa' is not installed" ;;
    esac
    is_promptless "$sa" && die "--synth cannot be '$sa': that adapter ignores the prompt and
     ships its own review contract, so it cannot merge reviews."
  fi

  # Single-use labels. Reusing one would hand back the previous review of
  # DIFFERENT code, which is the benchmark path's resume behaviour and is a
  # wrong answer here rather than a saved call.
  # A --full target need not be a git repo at all, so there is no HEAD to name
  # it after. Unlabelled, that produced "review--1" for every target.
  local short
  if [ "$full" = 1 ]; then
    short=$(slug "$(basename "$repo")")
  else
    short=$(git -C "$repo" rev-parse --short HEAD)
  fi
  if [ -n "$label" ]; then
    case "$label" in *[!a-zA-Z0-9_-]*) die "--label must be [a-zA-Z0-9_-]" ;; esac
  else
    local n=1; label="review-$short-1"
    while [ -e "$CADRE_HOME/reviews/$label" ]; do n=$((n + 1)); label="review-$short-$n"; done
  fi
  local out="$CADRE_HOME/reviews/$label"
  mkdir -p "$CADRE_HOME/reviews" || die "cannot create $CADRE_HOME/reviews"
  mkdir "$out" 2>/dev/null || die "$out already exists. Pick another --label."

  # ★ Say it when the panel is less independent than it looks. This is the ONE
  # property the whole tool rests on, and it is the easiest to lose by accident
  # -- adding a CLI feels like adding a reviewer, and a harness that fronts
  # gpt-5 or claude is not a new opinion, it is the same one wearing a different
  # CLI. A warning, never a refusal: deliberately running one family twice is a
  # legitimate thing to do (comparing two efforts of the same model is a real
  # experiment), and cadre does not get to overrule the roster.
  local fam=() dupfam sp
  for sp in "${specs[@]}"; do fam+=("$(spec_family "$sp")"); done
  dupfam=$(printf '%s\n' "${fam[@]}" | sort | uniq -d)
  if [ -n "$dupfam" ]; then
    local f i
    while IFS= read -r f; do
      local names=""
      for i in "${!specs[@]}"; do
        [ "${fam[$i]}" = "$f" ] && names="${names:+$names, }${specs[$i]}"
      done
      echo "⚠ $names are both $f models. That is one lineage in two seats:"
      echo "  they fail in the same places, so agreement between them is not"
      echo "  evidence and a [2/n] tag overstates the panel."
    done <<< "$dupfam"
  fi

  # ★ A shared QUOTA POOL is a third way to correlate a panel, beside lineage
  # and vendor, and it is the one that takes seats out all at once: the models
  # are genuinely different, so the warning above stays quiet, while one
  # exhausted account silently removes every seat behind it. Measured -- a panel
  # ran kiro:minimax-m2.5 beside kiro:glm-5, two real lineages, and BOTH seats
  # died together on kiro's account quota. Half the panel, one cause, no warning.
  # ★ The key is the AGENT plus the model's provider prefix if it has one. It
  # used to be `spec_model | cut -d/ -f1`, which on a slash-less model returns
  # the WHOLE model name -- so the two kiro seats hashed differently and the
  # check missed the exact case it exists for. A bare `kiro:glm-5` shares its
  # pool with every other kiro slot, so the model must not enter the key at all
  # unless it names a provider.
  local prov=() sp m
  for sp in "${specs[@]}"; do
    m=$(spec_model "$sp")
    case "$m" in
      */*) prov+=("$(spec_agent "$sp"):${m%%/*}") ;;
      *)   prov+=("$(spec_agent "$sp")") ;;
    esac
  done
  local dupprov; dupprov=$(printf '%s\n' "${prov[@]}" | sort | uniq -d)
  if [ "$jobs" -gt 1 ] && [ -n "$dupprov" ]; then
    local p names
    while IFS= read -r p; do
      names=""
      for i in "${!specs[@]}"; do
        [ "${prov[$i]}" = "$p" ] && names="${names:+$names, }${specs[$i]}"
      done
      echo "⚠ $names draw on the same account ($p). --jobs $jobs makes them"
      echo "  compete for one rate limit, and if it runs out they go dark"
      echo "  TOGETHER -- different models, one point of failure."
    done <<< "$dupprov"
  fi

  # ★ The child's exit code is PASSED THROUGH, not collapsed to 1. Returning a
  # bare 1 made "credentials in the tree, refused before any reviewer ran" (3)
  # indistinguishable from "the reviewers ran and failed" (1) to anything
  # wrapping cadre -- CI, or a review pipeline deciding whether to retry. A
  # refusal must never look like a flaky run, because the retry is the wrong
  # response to it.
  local rrc=0
  CADRE_PRERUN="$prerun" \
    "$CADRE_ROOT/lib/run-review.sh" "$repo" "$base" "$out" "$jobs" "${specs[@]}" || rrc=$?
  if [ "$rrc" -ne 0 ]; then
    # rmdir, not rm -rf: it succeeds only when the directory is empty, so a run
    # that died before writing anything leaves nothing behind, and one that
    # produced partial output keeps it. An empty review dir reads as a review
    # that found nothing, and it burns the label for the next attempt.
    rmdir "$out" 2>/dev/null
    return "$rrc"
  fi

  [ -n "$synth" ] && [ "$synth" != none ] && cmd_synthesize "$out" "$synth" "${specs[@]}"
  return 0
}

# Merge the reviews. A model too, so the same rate-limit rule applies, and a
# failure here must not cost the individual reviews: they are already on disk.
cmd_synthesize() {
  local out="$1" synth="$2"; shift 2
  local specs=("$@") sl body="" cap="${CADRE_SYNTH_MAX:-200000}"
  local dead=() srcspec=() srcfile=() srcstate=() total=0
  for sp in "${specs[@]}"; do
    sl=$(slug "$sp")
    if [ -s "$out/$sl.md" ];           then srcspec+=("$sp"); srcfile+=("$out/$sl.md");         srcstate+=(ok)
    elif [ -s "$out/$sl.md.partial" ]; then srcspec+=("$sp"); srcfile+=("$out/$sl.md.partial"); srcstate+=(degraded)
    else dead+=("$sp"); fi
  done
  local usable=${#srcspec[@]} i
  # Partials count toward having something to merge. One full review plus one
  # partial is still two independent looks at the diff.
  [ "$usable" -ge 2 ] || { echo "only $usable usable review(s); nothing to synthesize."; return 0; }
  for i in "${!srcfile[@]}"; do total=$((total + $(wc -c < "${srcfile[$i]}"))); done

  # Over budget, every review gets the same byte share. ★ head -c MAKES a review
  # partial: a full review cut at 40KB is silent about everything after 40KB for
  # exactly the reason a truncated one is. Re-label it degraded here or the
  # silence rule below skips the reviews this function itself just truncated.
  local per=0
  if [ "$total" -gt "$cap" ]; then
    per=$(( cap / usable ))
    # A share of 0 would announce a truncation and then perform none, quietly
    # sending the whole oversized body anyway.
    [ "$per" -lt 1 ] && per=1
    echo "⚠ reviews total $total bytes, over CADRE_SYNTH_MAX ($cap). Truncating each to $per."
  fi

  # ★ TWO different facts, kept apart. "The reviewer stopped early" is a fact
  # about the reviewer's health. "Cadre sent only the first N bytes" is a fact
  # about what this function did to a reviewer that finished perfectly well.
  # Both mean the silence that follows proves nothing, so both get the silence
  # rule -- but telling the synthesizer a healthy reviewer "stopped early" is
  # simply false, and it is the kind of false that ends up quoted in a report.
  local partial=() capped=() n=0 text cut
  for i in "${!srcspec[@]}"; do
    cut=0
    if [ "$per" -gt 0 ] && [ "$(wc -c < "${srcfile[$i]}")" -gt "$per" ]; then
      text=$(head -c "$per" "${srcfile[$i]}"); cut=1
    else
      text=$(cat "${srcfile[$i]}")
    fi
    # A DIFFERENT delimiter, not just different prose. Under the same delimiter
    # as a full review the synthesizer has no handle to apply a different rule
    # to, however carefully the instructions are worded.
    if [ "${srcstate[$i]}" = degraded ]; then
      body="$body===== REVIEWER (PARTIAL, THIS REVIEWER STOPPED EARLY): ${srcspec[$i]} ====="$'\n'"$text"$'\n\n'
      partial+=("${srcspec[$i]}")
    elif [ "$cut" = 1 ]; then
      body="$body===== REVIEWER (COMPLETE, BUT CADRE SENT ONLY ITS FIRST $per BYTES): ${srcspec[$i]} ====="$'\n'"$text"$'\n\n'
      capped+=("${srcspec[$i]}")
    else
      body="$body===== REVIEWER: ${srcspec[$i]} ====="$'\n'"$text"$'\n\n'
      n=$((n + 1))
    fi
  done
  local short=("${partial[@]}" "${capped[@]}")
  # ★ Two different counts, and conflating them made cadre lie in prose while
  # the arithmetic stayed right. $n is "full text in front of the synthesizer",
  # which is the correct denominator floor for a finding only the full reviews
  # could have named. It is NOT the number of reviewers who finished: a capped
  # reviewer reviewed the whole diff and returned a complete review, cadre just
  # sent part of it. Reporting $n as "returned a complete review" understates a
  # healthy panel, and when every survivor was capped the console announced
  # "synthesizing 0 review(s)" for a run that was about to synthesize several.
  local completed=$((n + ${#capped[@]}))

  # ★ Tell the synthesizer who DIED. Without this it sees two reviews, reports
  # "2/2 agree", and the reader concludes the panel was unanimous when a third
  # of it never returned. The header line the prompt asks for is what carries
  # that; these members are NOT in the tags, because a reviewer that never ran
  # has no opinion to count either way.
  if [ ${#dead[@]} -gt 0 ]; then
    body="$body===== FAILED, NO REVIEW: ${dead[*]} =====
These roster members produced no usable review. Say so in the verdict spread and
in the header line. Keep them out of every agreement tag: they neither agree nor
disagree with anything. This panel was ${#specs[@]} reviewers, of whom $completed
returned a complete review.

"
  fi
  # ★ Incomplete coverage breaks the agreement MATH, not just the prose, and in
  # the direction nobody checks. Tagging a finding [1/4] when two of the four
  # never reached that file reads as three dissents; it is one reviewer and two
  # absences. One rule for both causes, since the consequence is identical, but
  # each reviewer is listed under the cause that is actually true of it.
  if [ ${#short[@]} -gt 0 ]; then
    body="$body===== REVIEWERS WITH INCOMPLETE COVERAGE: ${short[*]} ====="$'\n'
    [ ${#partial[@]} -gt 0 ] && body="$body\
  ${partial[*]} -- stopped partway through, out of tokens or time.
"
    [ ${#capped[@]} -gt 0 ] && body="$body\
  ${capped[*]} -- reviewed the whole diff, but their review was too long for
  this synthesis and CADRE cut it. The reviewer is healthy; the copy you were
  given is not the whole of what it wrote. Do not say it stopped early.
"
    body="$body
Their text is a real review of the part you can see. Rules for them, unlike a
review you have in full:
  - On a finding one of them RAISED, it counts in both the numerator and the
    denominator, exactly like a complete review.
  - On a finding it never mentioned, it counts in NEITHER. That code is outside
    what you were given, so its silence is not agreement, disagreement, or
    clearance, and the denominator for that finding is smaller. Never list one
    under Disagreements for something it simply does not mention.
  - Give no overall verdict on behalf of a reviewer that stopped early.

Do the arithmetic for THIS panel. You have $n review(s) in full and ${#short[@]} with
incomplete coverage (${short[*]}). For each finding: denominator = $n, plus one
for EACH of those ${#short[@]} that raised that finding. So it is $n when none of them
raised it, and at most $((n + ${#short[@]})) when all of them did.

The low end is the case that gets written wrong. A defect only the full reviews
named is tagged [x/$n]. A bigger number there claims someone looked at that code
and declined to flag it, which is exactly backwards.

"
  fi

  local pf="$out/.synth-prompt" raw attempt=1 w
  { cat "$CADRE_ROOT/lib/prompts/synthesize.md"; echo; printf '%s' "$body"; } > "$pf"
  local pcount=""
  [ ${#capped[@]} -gt 0 ] && pcount="$pcount, ${#capped[@]} sent short"
  [ ${#partial[@]} -gt 0 ] && pcount="$pcount, ${#partial[@]} partial"
  echo "synthesizing $usable review(s)${pcount:+ ($n full$pcount)} with $synth ..."
  local a m mm=(); a=$(spec_agent "$synth"); m=$(spec_model "$synth")
  [ -n "$m" ] && mm=(-M "$m")
  local rc=0
  while :; do
    raw=$("$CADRE_ROOT/bin/agentcall" "$a" "${mm[@]}" -d /tmp -m ro < "$pf" 2>&1); rc=$?
    printf '%s' "$raw" > "$out/.synth-tmp"
    # ★ The THIRD retry loop. The commit that taught the two reviewer loops to
    # stop trusting a keyword scan over the adapter left this one asking the old
    # question, so a healthy short merge that discussed rate limiting burned
    # three retries and then got filed failed. Same principle, different test,
    # because a synthesis has no marker to be rescued by. See provider_refused.
    provider_refused "$out/.synth-tmp" "$rc" || { rm -f "$out/.synth-tmp"; break; }
    rm -f "$out/.synth-tmp"
    [ "$attempt" -ge "${CADRE_RETRIES:-3}" ] && break
    w=$(retry_wait "$attempt")
    echo "  synthesis rate limited, waiting ${w}s ($((attempt + 1))/${CADRE_RETRIES:-3})"
    sleep "$w"; attempt=$((attempt + 1))
  done
  rm -f "$pf"
  # ★ Same classifier the reviewers get. An auth error or an exhausted retry is
  # NON-EMPTY text, so testing only for emptiness filed the error itself as
  # synthesis.md and the reader saw a merged review that was really a 429. The
  # synthesizer is a model; it fails like one.
  # ★ Deliberately NOT three-state: only `ok` survives here. A partial merge is
  # worthless in a way a partial review is not, because the reviews it was
  # merging are already on disk and complete. Fail closed and keep them.
  printf '%s' "$raw" > "$out/.synth-tmp"
  if [ "$(classify_run "$out/.synth-tmp" "$rc" synth)" != ok ]; then
    mv "$out/.synth-tmp" "$out/synthesis.md.failed"
    echo "synthesis FAILED (rc=$rc), kept as synthesis.md.failed." >&2
    echo "The individual reviews are intact in $out." >&2
    return 0
  fi
  rm -f "$out/.synth-tmp"
  { echo "# Synthesis ($synth)"; echo
    echo "_Model-produced and unverified. It merges what the reviewers said; it has"
    echo "not seen the code. Read the individual reviews before acting._"; echo
    printf '%s\n' "$raw"
  } > "$out/synthesis.md"
  echo "saved: $out/synthesis.md"
}

# ---- the settled-decisions ledger --------------------------------------------
#
# ★ Cadre reviews once and stops, so on its own it cannot treadmill. The moment
# something WRAPS it in a loop, which is the normal way people use a review tool
# on a branch, every re-run re-raises findings the human already dismissed. The
# reviewers have no memory; the human is the only thing that remembers, and
# making them remember is how a review loop becomes unbearable.
#
# The ledger is a human-written file. Nothing writes to it automatically: a tool
# that files its own dismissals will eventually dismiss something real, and the
# whole value here is that a person decided. `cadre settle` only READS it.
LEDGER_HELP='One finding per line:

    <id> | <disposition> | <description>

  L1 | wontfix  | timestamps are strings from neon-http, callers wrap them
  L2 | accepted | missing test for the retry path, tracked in #412

disposition is yours; cadre does not interpret it.'

ledger_path() { echo "${CADRE_LEDGER:-$CADRE_HOME/ledger}"; }

cmd_ledger() {
  local lp; lp=$(ledger_path)
  case "${1:-show}" in
    show)
      if [ ! -s "$lp" ]; then
        echo "no ledger at $lp"; echo; echo "$LEDGER_HELP"; return 0
      fi
      echo "$lp"; echo
      # Comments and blanks are the user's; print the file as they wrote it.
      cat "$lp" ;;
    path) echo "$lp" ;;
    *) die "ledger: expected 'show' or 'path'" ;;
  esac
}

# Split one review into SETTLED / NEW against the ledger. Read-only, and it
# never edits the review: the finding stays on disk exactly as written.
cmd_settle() {
  local review="" judge="${CADRE_JUDGE:-}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --judge) judge="${2:?--judge needs an agent spec}"; shift 2 ;;
      -*) die "settle: unknown option '$1'" ;;
      *)  review="$1"; shift ;;
    esac
  done
  [ -n "$review" ] || die "usage: cadre settle <review-file-or-dir> [--judge spec]"

  # A review directory is the normal thing to have: point at the report.
  [ -d "$review" ] && review="$review/report.md"
  [ -s "$review" ] || die "no review to read at $review"

  local lp; lp=$(ledger_path)
  [ -s "$lp" ] || die "no ledger at $lp, so there is nothing settled yet.

     $LEDGER_HELP"

  [ -n "$judge" ] || { pick_judge || true; judge="${CADRE_JUDGE:-}"; }
  [ -n "$judge" ] || die "settle needs a judge. Set \$CADRE_JUDGE or pass --judge."

  # ★ Strip comments and blanks before the model sees it. A '#' line is a note
  # to the human, and feeding it as an entry invites a match against a comment.
  local entries; entries=$(grep -vE '^[[:space:]]*(#|$)' "$lp")
  [ -n "$entries" ] || die "$lp has no entries, only comments."

  local pf; pf=$(mktemp)
  { cat "$CADRE_ROOT/lib/prompts/settle.md"; echo
    echo "===== LEDGER ====="; printf '%s\n' "$entries"; echo
    echo "===== REVIEW ====="; cat "$review"
  } > "$pf"

  local a m mm=() raw rc
  a=$(spec_agent "$judge"); m=$(spec_model "$judge")
  [ -n "$m" ] && mm=(-M "$m")
  echo "matching against $(printf '%s\n' "$entries" | wc -l) ledger entries with $judge …"
  raw=$("$CADRE_ROOT/bin/agentcall" "$a" "${mm[@]}" -d /tmp -m ro < "$pf" 2>&1); rc=$?
  rm -f "$pf"

  # ★ Fail loudly. A settle pass that silently returns nothing looks exactly
  # like "everything here is already settled", which would hide a live finding
  # behind a judge that never ran.
  # ★ Models fence their JSON. `sed -n '/{/,$p'` took the first { to EOF, which
  # carries the CLOSING ``` along with it, and jq rejects the trailing fence --
  # so a judge that answered perfectly was reported as one that "failed or
  # stopped early". Measured with qwen as judge on a real panel: the correct
  # findings were printed in the error's own diagnostic lines, which is as close
  # to self-refuting as a message gets.
  # Take the first { to the LAST }, after dropping fence lines. That survives
  # prose on either side of the block and braces inside strings, which a
  # brace-counting scan does not. Anything that still is not JSON -- no object
  # at all, or a truncated one -- fails jq and is refused below, which is the
  # direction that has to stay safe.
  local js
  js=$(printf '%s' "$raw" \
       | sed -e '/^[[:space:]]*```/d' \
       | awk 'BEGIN{RS="\0"} {
             i=index($0,"{"); if(!i) exit; s=substr($0,i);
             for(k=length(s);k>0;k--) if(substr(s,k,1)=="}") { printf "%s", substr(s,1,k); exit }
           }' \
       | jq -c . 2>/dev/null) || js=""
  # ★ Two causes, one message, so say both. An adapter that truncates now exits
  # nonzero even when the JSON it printed parses fine, and reporting that as
  # "did not return usable JSON" describes the wrong problem to whoever has to
  # fix it. A partial match is still refused either way: settle's exit code is a
  # stopping rule, and half a match reads as "nothing new is left".
  if [ "$rc" -ne 0 ] || [ -z "$js" ]; then
    echo "cadre: the judge failed or stopped early, so nothing was matched." >&2
    printf '%s\n' "$raw" | head -5 | sed 's/^/     /' >&2
    return 1
  fi

  local total new
  total=$(printf '%s' "$js" | jq '.findings | length')
  new=$(printf '%s' "$js" | jq '[.findings[] | select(.status != "SETTLED")] | length')
  echo
  if [ "$total" -eq 0 ]; then echo "no findings in that review."; return 0; fi

  if [ "$new" -gt 0 ]; then
    echo "NEW ($new of $total):"
    printf '%s' "$js" | jq -r '.findings[] | select(.status != "SETTLED") | "  - \(.summary)"'
  fi
  if [ "$new" -lt "$total" ]; then
    echo
    echo "already settled ($((total - new)) of $total), shown so you can check the match:"
    printf '%s' "$js" | jq -r '.findings[] | select(.status == "SETTLED")
                               | "  - [\(.ledger_id // "?")] \(.summary)"'
  fi
  echo
  echo "The review itself is unchanged at $review."
  # ★ The exit status is the useful part for a wrapper: 0 means nothing new to
  # look at, so a loop can stop. Non-zero means a human still has something to
  # read. That is the stopping rule, and it is deliberately not automatic.
  [ "$new" -eq 0 ]
}

# Exits non-zero when a pass is broken. README and docs both say doctor FAILS a
# pass whose key sits inside the checkout, so it has to actually fail.
# ★ Prints and exits. It never writes your opencode config and never touches a
# key, because the moment cadre does either it becomes a credential path, and
# "we refuse to leak your secrets" stops being something it can claim. The
# walkthrough tells you what to run; --brief hands the config work to an agent
# you already trust, with a PLACEHOLDER where the key goes.
cmd_onboard() {
  local brief=""
  case "${1:-}" in
    --brief) brief=1 ;;
    "") ;;
    *) die "onboard: unknown option '$1' (only --brief)" ;;
  esac

  local doc="$CADRE_ROOT/docs/FREE-PANEL.md"
  local have; have=$("$CADRE_ROOT/bin/agentcall" --installed 2>/dev/null | paste -sd, -)

  if [ -n "$brief" ]; then
    cat <<EOF
Copy everything below into your coding agent.
------------------------------------------------------------------------
I use a tool called cadre that runs several AI code reviewers on the same
diff. I have these reviewer CLIs installed: ${have:-none}. I want to add one
more from a DIFFERENT model family, for free, so the panel stops being one
opinion repeated.

Read $doc and then do this for me:

1. Run \`opencode models\`. If it lists anything ending in \`-free\`, tell me
   the roster line to use and STOP; that route needs no key and no config.
2. Otherwise help me pick one free provider, and edit
   ~/.config/opencode/opencode.json to add its provider block. Merge into the
   existing file, do not overwrite it, and show me a diff before you write.
3. ★ For the API key, put the literal placeholder "{env:PROVIDER_API_KEY}"
   with the right variable name. Do NOT ask me for the key, do not read it
   from any file, and do not put a real key anywhere. Then tell me which of
   the three commands in "Where the key goes" to run myself.
4. Do NOT put the key in the repo's .env. Cadre's credential preflight refuses
   to run against a tree containing one, so that would break every review.
5. Finish by telling me the exact \`cadre review --roster a,b\` line to try.
------------------------------------------------------------------------
EOF
    return 0
  fi

  # ★ Two of the three routes go through opencode. Printing `opencode models`
  # to someone who does not have it is the same "command not found" fumble this
  # command exists to prevent.
  local oc_note=""
  command -v opencode >/dev/null 2>&1 \
    || oc_note="
    ⚠ opencode is not installed, and the two routes below need it. It is one
      CLI that reaches many model families, which is why it is the cheapest
      way to add a lineage: https://opencode.ai
"
  cat <<EOF
Adding a second reviewer, free.

You have installed: ${have:-nothing cadre recognises}
$oc_note
Fastest route, no key and no config. If this lists anything ending in -free,
it is usable as a reviewer immediately:

    opencode models

    cadre review --roster ${have%%,*}${have:+,}opencode:opencode/<the-free-one>

Next easiest, CodeRabbit. A real reviewer on a free tier, three reviews an
hour, nothing to configure once its CLI is installed and logged in:

    cadre review --roster ${have%%,*}${have:+,}coderabbit

A keyed free tier, if you want a specific model family. opencode prompts for
the key with the input masked and stores it itself; cadre never sees it:

    opencode auth login -p cerebras
    opencode models cerebras
    cadre review --roster ${have%%,*}${have:+,}opencode:cerebras/<model>

Full walkthrough, including the provider table, the three ways to supply a key
without it landing in an agent's transcript, and why the key must NOT go in
the repo's .env:

    $doc

Or, to have your own coding agent do the config for you:

    cadre onboard --brief
EOF
}

cmd_doctor() {
  local probe="${1:-}" bad=0
  echo "CADRE_ROOT  $CADRE_ROOT"
  echo "CADRE_HOME  $CADRE_HOME"
  local t
  for t in git jq awk; do
    printf '%-11s %s\n' "$t" "$(command -v "$t" >/dev/null 2>&1 && echo ok || echo MISSING)"
  done
  pick_judge || true
  printf '%-11s %s\n' judge "${CADRE_JUDGE:-NONE, set CADRE_JUDGE}"
  echo
  echo "adapters:"
  "$CADRE_ROOT/bin/agentcall" --list | sed 's/^/  /'
  if [ "$probe" = --probe ]; then
    echo
    echo "probing (one call per installed CLI):"
    "$CADRE_ROOT/bin/agentcall" --probe | sed 's/^/  /'
  fi
  # ★ Data, not a warning. One CLI is a valid setup and doctor still exits 0.
  # But a one-model panel is the exact configuration this tool was built to
  # measure, so state what the measurement says and let them decide.
  local ninst
  ninst=$("$CADRE_ROOT/bin/agentcall" --installed 2>/dev/null | wc -l)
  if [ "$ninst" -le 1 ]; then
    cat <<'EOF'

  one reviewer installed. That works, and cadre will run it.

  Worth knowing before you decide it is enough. Cadre's own scaffolding was
  reviewed by three models one at a time, and EACH of the three found a harness
  bug the other two missed. Three runs on one repo is not a sample size, but a
  single reviewer is confidently silent about what it misses, and the only
  thing that has surfaced that here is a second one from a DIFFERENT family.

  Measure it on your repo rather than take our word: run a second candidate
  through the same passes and read the per-item rows, not the totals. The
  largest public measurement points the same way, but it is someone else's
  preprint on someone else's codebase -- a direction, not your number. See
  README.md.

  A second lineage does not need a subscription, and there is a route that
  needs no API key at all:

      cadre onboard
EOF
  fi
  echo
  echo "passes:"
  if [ ! -s "$PASSES" ]; then
    echo "  none registered. Run: cadre setup <repo-dir>"
  else
    local label sha dir base key kf tgt
    while IFS='|' read -r label sha dir base key; do
      case "$label" in ''|\#*) continue ;; esac
      kf="$key"; case "$kf" in /*) ;; *) kf="$CADRE_HOME/$key" ;; esac
      tgt="$dir"; case "$tgt" in /*) ;; *) tgt="$CADRE_HOME/$dir" ;; esac
      printf '  %-18s ' "$label"
      if [ ! -d "$tgt" ]; then echo "MISSING CHECKOUT $tgt"; bad=1
      elif [ ! -f "$kf" ]; then echo "MISSING KEY $kf"; bad=1
      elif is_inside "$kf" "$tgt"; then
        echo "★ KEY IS INSIDE THE CHECKOUT, reviewers can read the answers"; bad=1
      elif [ -n "$(key_problems "$kf")" ]; then
        echo "KEY NOT GRADEABLE:"; key_problems "$kf" | sed 's/^/      /'; bad=1
      else
        echo "ok, $(key_items "$kf" | wc -l) key items, $(git -C "$tgt" rev-list --count HEAD 2>/dev/null) commits visible"
      fi
    done < "$PASSES"
  fi
  cat <<'EOF'

Not implemented yet (do not rely on them):
  - cost estimation in currency; `cadre run` prints a CALL COUNT only
  - resuming a partially-failed pass beyond "skip outputs that already exist"
  - sandboxing the agents. Scrubbing CADRE_* from their environment stops the
    key path being advertised; an agent with filesystem read can still go
    looking. `cadre run` flags a review that quotes the key verbatim.
EOF
  [ "$bad" -eq 0 ] || { echo; echo "doctor: one or more passes are broken (see ★ above)"; return 1; }
}

case "${1:-}" in
  setup)     shift; cmd_setup "$@" ;;
  make-pass) shift; cmd_make_pass "$@" ;;
  add-pass)  shift; cmd_add_pass "$@" ;;
  run)       shift; cmd_run "$@" ;;
  grade)     shift; cmd_grade "$@" ;;
  adjudicate) shift; cmd_adjudicate "$@" ;;
  panel)     shift; cmd_panel "$@" ;;
  review)    shift; cmd_review "$@" ;;
  passes)    shift; cmd_passes "$@" ;;
  agents)    shift; "$CADRE_ROOT/bin/agentcall" --list ;;
  doctor)    shift; cmd_doctor "$@" ;;
  onboard)   shift; cmd_onboard "$@" ;;
  ledger)    shift; cmd_ledger "$@" ;;
  settle)    shift; cmd_settle "$@" ;;
  dataset)   shift; init_home; "$CADRE_ROOT/lib/aggregate.sh" "$@" ;;
  ""|-h|--help) usage ;;
  *) echo "cadre: unknown command '$1'" >&2; echo; usage; exit 2 ;;
esac
